---
import Menu from '../assets/icons/menu.svg';
---

<header class="bg-blue-700 dark:bg-blue-800 text-white p-4 shadow-md transition-colors duration-300">
  <div class="container mx-auto flex justify-between items-center pl-4 pr-4">
    <div class="flex items-center">
      <div class="relative group">
        <button id="menu-toggle" class="focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-500 rounded mr-4" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu">
          <Menu class="h-6 w-6" aria-hidden="true" />
        </button>
        <nav id="menu" aria-label="Main" class="hidden absolute left-0 mt-2 w-48 bg-white dark:bg-slate-800 text-slate-800 dark:text-white rounded shadow-lg z-10 transition-colors duration-300">
          <ul class="py-1">
            <li><a href="/" class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-700">Home</a></li>
            <li><a href="/about" class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-700">About</a></li>
          </ul>
        </nav>
      </div>
      <div class="text-xl font-bold"><a href="/" class="hover:underline">Tailspin Toys</a></div>
    </div>
    <div class="flex flex-wrap justify-end gap-2">
      <button
        id="high-contrast-toggle"
        type="button"
        class="rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-700"
        aria-label="Toggle high contrast mode"
        aria-pressed="false"
        data-testid="high-contrast-toggle"
      >
        High contrast: off
      </button>
      <button
        id="light-mode-toggle"
        type="button"
        class="rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-700"
        aria-label="Toggle light mode"
        aria-pressed="false"
        data-testid="light-mode-toggle"
      >
        Light mode: off
      </button>
    </div>
  </div>
</header>

<script>
  // Toggle menu visibility when hamburger is clicked
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');
  
  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      const isExpanded = !menu.classList.contains('hidden');
      menuToggle.setAttribute('aria-expanded', String(isExpanded));
      if (isExpanded) {
        const firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      }
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      const target = event.target;
      const isClickInside = target instanceof Node && (menuToggle.contains(target) || menu.contains(target));
      if (!isClickInside && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Close menu with Escape key and return focus to toggle button
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.focus();
      }
    });
  }

  const contrastToggle = document.getElementById('high-contrast-toggle');

  if (contrastToggle) {
    const storageKey = 'tailspin-high-contrast';

    const updateContrastToggle = (enabled: boolean) => {
      contrastToggle.setAttribute('aria-pressed', String(enabled));
      contrastToggle.textContent = `High contrast: ${enabled ? 'on' : 'off'}`;
    };

    let isHighContrast = document.documentElement.classList.contains('high-contrast');
    updateContrastToggle(isHighContrast);

    contrastToggle.addEventListener('click', () => {
      isHighContrast = !isHighContrast;
      document.documentElement.classList.toggle('high-contrast', isHighContrast);
      updateContrastToggle(isHighContrast);

      try {
        localStorage.setItem(storageKey, String(isHighContrast));
      } catch {
        // Keep the current page usable when local storage is unavailable.
      }
    });
  }

  const lightModeToggle = document.getElementById('light-mode-toggle');

  if (lightModeToggle) {
    const storageKey = 'tailspin-light-mode';

    const updateLightModeToggle = (enabled: boolean) => {
      lightModeToggle.setAttribute('aria-pressed', String(enabled));
      lightModeToggle.textContent = `Light mode: ${enabled ? 'on' : 'off'}`;
    };

    let isLightMode = document.documentElement.classList.contains('light-mode');
    updateLightModeToggle(isLightMode);

    lightModeToggle.addEventListener('click', () => {
      isLightMode = !isLightMode;
      document.documentElement.classList.toggle('light-mode', isLightMode);
      updateLightModeToggle(isLightMode);

      try {
        localStorage.setItem(storageKey, String(isLightMode));
      } catch {
        // Keep the current page usable when local storage is unavailable.
      }
    });
  }
</script>