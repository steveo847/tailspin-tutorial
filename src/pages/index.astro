---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 md:flex-row md:items-end md:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        <form class="grid grid-cols-1 gap-3 sm:grid-cols-2" data-testid="game-filters">
          <div>
            <label for="category-filter" class="block text-sm font-medium text-slate-300 mb-1">Categories</label>
            <select
              id="category-filter"
              name="categories"
              multiple
              size={Math.min(Math.max(categories.length, 2), 4)}
              class="w-full min-w-44 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="category-filter"
            >
              {categories.map((category) => <option value={category.id}>{category.name}</option>)}
            </select>
          </div>

          <div>
            <label for="publisher-filter" class="block text-sm font-medium text-slate-300 mb-1">Publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full min-w-44 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>

          <button
            type="reset"
            class="sm:col-span-2 justify-self-start rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-300 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="clear-filters"
          >Clear filters</button>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}

      <div class="hidden" data-testid="filtered-empty-state" role="status" aria-live="polite">
        <EmptyState text="No games match these filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearFilters = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  function applyFilters(): void {
    if (!categoryFilter || !publisherFilter || !emptyState) return;

    const categoryIds = new Set([...categoryFilter.selectedOptions].map((option) => option.value));
    const publisherId = publisherFilter.value;
    let visibleCards = 0;

    for (const card of cards) {
      const matchesCategory = categoryIds.size === 0 || categoryIds.has(card.dataset.gameCategoryId ?? '');
      const matchesPublisher = publisherId === '' || card.dataset.gamePublisherId === publisherId;
      const isVisible = matchesCategory && matchesPublisher;
      card.hidden = !isVisible;
      if (isVisible) visibleCards += 1;
    }

    emptyState.classList.toggle('hidden', visibleCards > 0);
  }

  categoryFilter?.addEventListener('change', applyFilters);
  publisherFilter?.addEventListener('change', applyFilters);
  clearFilters?.addEventListener('click', () => requestAnimationFrame(applyFilters));
</script>
